# Export in the shell launching Claude/Codex; this file is NOT auto-loaded.
SYSTEM_ONE_URL=http://127.0.0.1:8009
SYSTEM_ONE_MODEL=kev-latest
SYSTEM_ONE_PROVIDER=kev
SYSTEM_ONE_TIMEOUT_MS=20000
SYSTEM_ONE_ALLOW_REMOTE=0
SYSTEM_ONE_JEV_ALIASES=0
SYSTEM_ONE_BELAY_SHADOW=0
# SYSTEM_ONE_API_KEY=your-secret
# SYSTEM_ONE_API_KEY_FILE=/absolute/private/system-one.key
# OPEN_JEV_BRIDGE_CONFIG=/absolute/path/to/config.json
# OPEN_JEV_BRIDGE_DATA=/absolute/path/to/private-state

# Automatic lifecycle tasks; enabled by default.
SYSTEM_ONE_AUTO_VERIFY=true
SYSTEM_ONE_AUTO_REVIEW=true
SYSTEM_ONE_AUTO_SCREEN=true
SYSTEM_ONE_AUTO_COMPACTION=true
# Only the optional Claude function runtime uses this percentage trigger.
SYSTEM_ONE_COMPACT_AT_PERCENT=60
